# Copy to .env (or export in the shell). Scripts set these themselves; this file is the host default.

# mock → local UI mocks, no server (npm run dev)
# qa   → local Docker Supabase (npm run qa:up, then npm run dev:qa)
# prod → hosted Supabase (npm run dev:prod). Needs PROD_DATABASE_URL below.
PLANTX_ENV=qa
VITE_PLANTX_ENV=mock

# Postgres URI for the hosted Supabase project (Project Settings → Database).
# Hosted serverless uses the transaction pooler (port 6543). A session-pooler URL on port 5432 is switched automatically.
# PROD_DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Optional seed override when the database is empty: empty | demo
# PLANTX_SEED=empty

# Google Identity (Gmail SSO). Create an OAuth 2.0 Web client in Google Cloud Console.
# Authorized JavaScript origins — the page origin only. The button does not use redirect URIs.
#   http://127.0.0.1:5173
#   http://localhost:5173
#   https://plantx-coral.vercel.app
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
# The operator's Google account: the only sign-in that becomes admin. Unset → Google grants no admin
# (the existing admin row keeps its role). Set it on Vercel; never commit the real address.
# PLANTX_BOOTSTRAP_ADMIN_EMAIL=operator@example.com
# Local only: a machine that cannot reach Google may skip the ID-token signature check.
# Ignored on every Vercel deployment.
# PLANTX_GOOGLE_INSECURE_LOCAL=1

# Two domains (production): the marketing landing and the app. Leave both unset to serve
# everything from one host with the landing at /landing (dev, QA, previews).
# Add the app origin to Google's Authorized JavaScript origins; the landing has no sign-in.
# VITE_APP_URL=https://app.example.com
# VITE_LANDING_URL=https://example.com

# HMAC key for the session cookie. Required in production; QA uses a fixed dev key.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=

# Photo identify (server only). Chain: Plant.id → Pl@ntNet → Gemini.
# KINDWISE_API_KEY=
# PLANTNET_API_KEY=
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# Unset, Gemini tries gemini-3.8-flash then older flash models when Google
# returns 404, 429, or 503. Set this to try one model first.
# Local only. PEM bundle for antivirus HTTPS scanning (fixes UNABLE_TO_VERIFY_LEAF_SIGNATURE
# on provider calls). Defaults to %TEMP%\plantx-win-cas.pem when that file exists.
# PLANTX_EXTRA_CA=

# PP: every Vercel preview (any branch) runs against PlantX-PP. See docs/preprod.md.
# Test login for AI testers and load runs; also forces photo identify to mock mode.
# Off on any Vercel production deployment even when set.
# PLANTX_PREPROD=1
# PLANTX_TEST_TOKEN=
# Used only by npm run seed:preprod (never the prod URL).
# PREPROD_DATABASE_URL=
