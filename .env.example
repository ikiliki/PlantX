# Copy to .env (or export in the shell). Scripts set these themselves; this file is the host default.

# mock → local UI mocks, no server (npm run dev / dev:local)
# qa   → QA JSON files in server/data (npm run dev:qa). Later a separate QA database.
# prod → production JSON files (npm run dev:prod, npm run build:prod). On Vercel, files on that server.
PLANTX_ENV=qa
VITE_PLANTX_ENV=mock

# Optional seed override when the data folder is empty: empty | demo
# PLANTX_SEED=empty

# Google Identity (Gmail SSO). Create an OAuth 2.0 Web client in Google Cloud Console.
# Authorized JavaScript origins — the page origin only. The button does not use redirect URIs.
#   http://127.0.0.1:5173
#   http://localhost:5173
#   https://plantx-coral.vercel.app
# Operator admin (omri96david@gmail.com) signs in with Google only — no password.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
