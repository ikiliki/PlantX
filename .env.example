# Copy to .env (or export in the shell). Scripts set these themselves; this file is the host default.

# mock → local UI mocks, no server (npm run dev)
# qa   → local Docker Supabase (npm run qa:up, then npm run dev:qa)
# prod → hosted Supabase (npm run dev:prod). Needs PROD_DATABASE_URL below.
PLANTX_ENV=qa
VITE_PLANTX_ENV=mock

# Postgres URI for the hosted Supabase project (Project Settings → Database).
# Use the session or direct connection (port 5432), not the transaction pooler.
# PROD_DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Optional seed override when the database is empty: empty | demo
# PLANTX_SEED=empty

# Google Identity (Gmail SSO). Create an OAuth 2.0 Web client in Google Cloud Console.
# Authorized JavaScript origins — the page origin only. The button does not use redirect URIs.
#   http://127.0.0.1:5173
#   http://localhost:5173
#   https://plantx-coral.vercel.app
# Operator admin (omri96david@gmail.com) signs in with Google only — no password.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
