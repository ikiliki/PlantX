{
  "name": "plantx",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:local",
    "dev:local": "tsx scripts/dev-web.ts mock",
    "dev:mock": "tsx scripts/dev-web.ts mock",
    "dev:qa": "concurrently -k -n qa-api,qa-web -c green,cyan \"npm run dev:api:qa\" \"npm run dev:web:qa\"",
    "dev:prod": "concurrently -k -n prod-api,prod-web -c magenta,white \"npm run dev:api:prod\" \"npm run dev:web:prod\"",
    "dev:web:local": "tsx scripts/dev-web.ts mock",
    "dev:web:mock": "tsx scripts/dev-web.ts mock",
    "dev:web:qa": "tsx scripts/dev-web.ts qa",
    "dev:web:prod": "tsx scripts/dev-web.ts prod",
    "dev:api:qa": "tsx scripts/dev-api-qa.ts",
    "dev:api:prod": "tsx scripts/dev-api-prod.ts",
    "qa:up": "node ./node_modules/supabase/dist/supabase.js start",
    "qa:down": "node ./node_modules/supabase/dist/supabase.js stop",
    "qa:reset": "node ./node_modules/supabase/dist/supabase.js db reset",
    "qa:status": "node ./node_modules/supabase/dist/supabase.js status",
    "seed:fixtures": "tsx scripts/write-demo-fixtures.ts",
    "seed:empty": "tsx scripts/reset-data.ts empty",
    "seed:demo": "tsx scripts/reset-data.ts demo",
    "build": "tsc && vite build",
    "build:prod": "node scripts/build-prod.mjs",
    "preview": "vite preview",
    "smoke": "node scripts/smoke.mjs",
    "scrape": "node scripts/scrape.mjs --headless",
    "scrape:headed": "node scripts/scrape.mjs --headed"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/styled-components": "^5.1.36",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.63.0",
    "puppeteer-core": "^24.2.0",
    "supabase": "^2.119.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@hono/swagger-ui": "^0.6.1",
    "concurrently": "^10.0.5",
    "hono": "^4.13.12",
    "leaflet": "^1.9.4",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "styled-components": "^6.5.3"
  }
}
